# Supabase — copy from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Mapbox — https://account.mapbox.com/access-tokens/ (used for lounge detail page map)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# Google Maps — https://console.cloud.google.com (enable Maps JavaScript API + Places API)
# Used for interactive terminal navigation maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIzaSy...

# AeroDataBox via RapidAPI — https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# Free tier: 2,000 requests/day
AERODATABOX_API_KEY=your-rapidapi-key-here

# Site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase service role key — server-side admin operations.
# Get from Supabase Settings > API > Project API keys > service_role.
# NEVER expose to client. Used in scripts/ and any server-only admin routes.
SUPABASE_SERVICE_KEY=sb_secret_...

# Sentry — error monitoring. Get from sentry.io > Settings > Client Keys (DSN).
# When set, errors are reported in production. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
# Optional — sourcemap upload during build (only needed if you want decoded stack traces)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Affiliate program IDs. Every value here is appended to outbound partner links
# via lib/affiliates.ts. Any variable left blank produces a plain (un-tracked)
# link that still works — the tracking parameter simply gets skipped.
# ─────────────────────────────────────────────────────────────────────────────

# FinlyWealth — primary Canadian credit-card affiliate.
# Sign in at finlywealth.com > affiliate hub > profile to find your ref code.
# Every finlywealth.com URL on the site becomes ?ref=<this-value> automatically.
NEXT_PUBLIC_AFF_FINLYWEALTH=p5n0

# Ratehub via Impact.com — approved but not yet activated.
# Set this once you have your Media Partner ID from Impact.com.
NEXT_PUBLIC_AFF_RATEHUB=

# Priority Pass / DragonPass direct affiliate programs (via Impact or CJ).
NEXT_PUBLIC_AFF_PRIORITY_PASS=
NEXT_PUBLIC_AFF_DRAGONPASS=

# Day-pass booking affiliates.
NEXT_PUBLIC_AFF_PLAZA_PREMIUM=
NEXT_PUBLIC_AFF_ASPIRE=
NEXT_PUBLIC_AFF_WESTJET=
NEXT_PUBLIC_AFF_LOUNGEBUDDY=

# Amazon Associates.ca — for travel-gear posts (headphones, chargers, packing).
# Value looks like "airportloung-20".
NEXT_PUBLIC_AFF_AMAZON_CA=

# Booking.com — hotel affiliate (partner ID / aid).
NEXT_PUBLIC_AFF_BOOKING=

# Credit Card Genius affiliate ID.
NEXT_PUBLIC_AFF_CREDIT_CARD_GENIUS=

# ─────────────────────────────────────────────────────────────────────────────
# Display ad network — leave blank until Mediavine Journey / Raptive approves.
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_AD_NETWORK=mediavine  # or "raptive" or "adsense"
